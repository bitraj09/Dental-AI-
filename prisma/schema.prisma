generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───
enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AIModel {
  GOOGLE_AI
  MOCK_AI
  OWN_AI
}

// ─── User ───
model User {
  id              Int        @id @default(autoincrement())
  email           String     @unique
  password        String
  name            String
  collegeName     String
  collegeYear     String
  collegeIdNumber String
  idCardPath      String?
  role            UserRole   @default(USER)
  status          UserStatus @default(PENDING)
  rejectionReason String?    @db.Text
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  records         Record[]
}

// ─── Patient Record ───
model Record {
  id             Int      @id @default(autoincrement())
  type           String
  patientName    String
  findings       Json
  summary        String   @db.Text
  imageThumbnail String?  @db.LongText
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])
  userId         Int
}

// ─── System Config (AI Model Switcher etc.) ───
model SystemConfig {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
